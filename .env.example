# ============================================================
# CONFIGURATION INVESTBOT — Copier ce fichier en .env
# Ne jamais committer le fichier .env avec de vraies valeurs !
# ============================================================

# Token du bot Telegram (obtenu via @BotFather avec /newbot ou /revoke)
TELEGRAM_BOT_TOKEN=

# ID Telegram de l'utilisateur autorisé (seul cet ID peut interagir avec le bot)
CHAT_ID=

# Clé API Anthropic pour les analyses IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Fuseau horaire pour le digest quotidien
TIMEZONE=Europe/Paris

# Heure d'envoi du digest quotidien (format 24h)
DIGEST_HOUR=8
DIGEST_MINUTE=0

# Intervalle de vérification des alertes prix (en minutes)
ALERT_CHECK_INTERVAL_MINUTES=30

# Mode debug (true/false) — affiche les logs détaillés
DEBUG=false

# ============================================================
# CONFIGURATION TRADINGBOT (trading_bot.py)
# ============================================================

# Clé API Trading 212 (App → Paramètres → API → Générer clé)
T212_API_KEY=
T212_API_KEY_ID=

# true = compte démo (simulation), false = argent réel
T212_DEMO=true
TEST_TRADE=false

# Gestion du risque (valeurs par défaut recommandées)
STOP_LOSS_PCT=0.03           # Stop-loss à -3%
MAX_POSITION_PCT=0.20        # Max 20% du portfolio par position
DAILY_LOSS_LIMIT_PCT=0.05    # Suspend le trading si -5% dans la journée
